{
  "name": "graphql-mssql-app",
  "version": "1.0.0",
  "description": "Full-stack application using Apollo Client, GraphQL, MSSQL, and Prisma",
  "main": "server/index.js",
  "scripts": {
    "dev": "nodemon server/index-prisma.js",
    "dev:prisma": "nodemon server/index-prisma.js",
    "dev:hybrid": "nodemon server/index-hybrid.js",
    "dev:original": "nodemon server/index.js",
    "start": "node server/index-prisma.js",
    "start:prisma": "node server/index-prisma.js",
    "start:hybrid": "node server/index-hybrid.js",
    "client": "cd client && npm start",
    "server": "node server/index.js",
    "server:prisma": "node server/index-prisma.js",
    "server:hybrid": "node server/index-hybrid.js",
    "build": "cd client && npm run build",
    "prisma:generate": "npx prisma generate",
    "prisma:db:pull": "npx prisma db pull",
    "prisma:db:push": "npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@prisma/client": "^5.0.0",
    "apollo-server-express": "^3.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "mssql": "^10.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0"
  },
  "keywords": [
    "graphql",
    "apollo",
    "mssql",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}
